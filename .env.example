# ── NocoDB ──────────────────────────────────────────────────
NOCODB_TOKEN=your_nocodb_token_here

NOCODB_USERS_URL=https://your-nocodb-instance/api/v3/meta/tables/TABLE_ID/records
NOCODB_LEADS_URL=https://your-nocodb-instance/api/v3/meta/tables/TABLE_ID/records
NOCODB_PROJECTS_URL=https://your-nocodb-instance/api/v3/meta/tables/TABLE_ID/records
NOCODB_USER_PROJECTS_URL=https://your-nocodb-instance/api/v3/meta/tables/TABLE_ID/records
NOCODB_TASKS_URL=https://your-nocodb-instance/api/v3/meta/tables/TABLE_ID/records
NOCODB_NOTIFICATIONS_URL=https://your-nocodb-instance/api/v3/meta/tables/TABLE_ID/records
NOCODB_MODULES_URL=https://your-nocodb-instance/api/v3/meta/tables/TABLE_ID/records
NOCODB_USER_MODULES_URL=https://your-nocodb-instance/api/v3/meta/tables/TABLE_ID/records
NOCODB_ACTIVITY_LOG_URL=https://your-nocodb-instance/api/v3/meta/tables/TABLE_ID/records
NOCODB_RESOURCES_URL=https://your-nocodb-instance/api/v3/meta/tables/TABLE_ID/records
NOCODB_CONTENT_URL=https://your-nocodb-instance/api/v3/meta/tables/TABLE_ID/records

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret

# ── IA (opcional) ────────────────────────────────────────────
# Obtené tu key en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS (opcional, separado por comas) ──────────────────────
# CORS_ORIGINS=https://tudominio.com,https://api.tudominio.com

# ── n8n (opcional) ───────────────────────────────────────────
