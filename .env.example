# ── NocoDB ──────────────────────────────────────────────────
NOCODB_TOKEN=your_nocodb_token_here

# ID del base (workspace). Se ve en la URL de NocoDB: /dashboard/#/BASE_ID/...
NOCODB_BASE=your_base_id_here

# IDs de cada tabla. Se ven en la URL al abrir la tabla en NocoDB.
# Por defecto el host es https://app.nocodb.com/api/v3/data (NocoDB Cloud).
# Para instancias self-hosted: NOCODB_HOST=https://tu-instancia/api/v3/data
NOCODB_USERS_TABLE=your_table_id_here
NOCODB_LEADS_TABLE=your_table_id_here
NOCODB_PROJECTS_TABLE=your_table_id_here
NOCODB_USER_PROJECTS_TABLE=your_table_id_here
NOCODB_TASKS_TABLE=your_table_id_here
NOCODB_NOTIFICATIONS_TABLE=your_table_id_here
NOCODB_MODULES_TABLE=your_table_id_here
NOCODB_USER_MODULES_TABLE=your_table_id_here
NOCODB_ACTIVITY_LOG_TABLE=your_table_id_here
NOCODB_RESOURCES_TABLE=your_table_id_here
NOCODB_CONTENT_TABLE=your_table_id_here
NOCODB_PROJECT_MESSAGES_TABLE=your_table_id_here

# ── Auth ─────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret

# ── IA (opcional) ────────────────────────────────────────────
# Obtené tu key en https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── Servidor ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── CORS (opcional, separado por comas) ──────────────────────
# CORS_ORIGINS=https://tudominio.com,https://api.tudominio.com

# ── n8n (opcional) ───────────────────────────────────────────
# N8N_LEAD_WEBHOOK=https://tu-instancia-n8n/webhook/lead
# N8N_API_KEY=your_n8n_api_key_here
# Generar con: openssl rand -hex 32
# Configurar el mismo valor en n8n como header de validación: X-OCHO-Api-Key
